/*
 * Featherio: 34-key unibody, Seeed XIAO nRF52840 Plus (non-Sense).
 *
 * Pins come from the handoff PIN_TABLE (schematic/PCB netlist extraction).
 * The xiao_ble board definition only knows D0-D10, so the Plus-only pads
 * (D11-D19) are written as raw nRF GPIOs. Rows/cols are written raw too so
 * that every line can be checked against the pin table directly.
 *
 * Stage 4: key matrix, LPPS pointing stick (I2C P0.04/P0.05, MOTION P1.11),
 * AAAA (NiMH) cell-sense ADC on P0.02/AIN0, DYA Studio runtime modules.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout;
    };

    /* 100 units = one 16.5 mm key pitch. The four centre keys (SW15/16/25/26)
     * sit 2.3 mm inboard on the PCB but are drawn on the grid by request. */
    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100  600    0       0     0     0>
            , <&key_physical_attrs 100 100  700    0       0     0     0>
            , <&key_physical_attrs 100 100  800    0       0     0     0>
            , <&key_physical_attrs 100 100  900    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  100       0     0     0>
            , <&key_physical_attrs 100 100  600  100       0     0     0>
            , <&key_physical_attrs 100 100  700  100       0     0     0>
            , <&key_physical_attrs 100 100  800  100       0     0     0>
            , <&key_physical_attrs 100 100  900  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100  600  200       0     0     0>
            , <&key_physical_attrs 100 100  700  200       0     0     0>
            , <&key_physical_attrs 100 100  800  200       0     0     0>
            , <&key_physical_attrs 100 100  900  200       0     0     0>
            , <&key_physical_attrs 100 100  300  324       0     0     0>
            , <&key_physical_attrs 100 100  400  324       0     0     0>
            , <&key_physical_attrs 100 100  500  324       0     0     0>
            , <&key_physical_attrs 100 100  600  324       0     0     0>
            ;
    };

    /* Keymap index 0..33 = SW1..SW34. Not the mirrored aerogu34 transform. */
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4) RC(3,5) RC(3,6)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row0  D14 / NFC1 */
            , <&gpio0 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row1  D1 */
            , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row2  D2 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row3  D3 */
            ;

        col-gpios
            = <&gpio1 12 GPIO_ACTIVE_HIGH>  /* Col0  D7 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  /* Col1  D8 */
            , <&gpio1 14 GPIO_ACTIVE_HIGH>  /* Col2  D9 */
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  /* Col3  D10 */
            , <&gpio0 15 GPIO_ACTIVE_HIGH>  /* Col4  D11 */
            , <&gpio0 19 GPIO_ACTIVE_HIGH>  /* Col5  D12 */
            , <&gpio1 1  GPIO_ACTIVE_HIGH>  /* Col6  D13 */
            , <&gpio1 3  GPIO_ACTIVE_HIGH>  /* Col7  D17 */
            , <&gpio1 5  GPIO_ACTIVE_HIGH>  /* Col8  D18 */
            , <&gpio1 7  GPIO_ACTIVE_HIGH>  /* Col9  D19 */
            ;
    };
};

/* Row0 is on P0.09 (NFC1): release the NFC pins to GPIO. */
&uicr {
    nfct-pins-as-gpios;
};

/* Board defaults that would claim matrix / LPPS pins. */
&uart0 { status = "disabled"; };  /* D6/D7 = LPPS MOTION / Col0 */
&spi2  { status = "disabled"; };  /* D8-D10 = Col1-Col3 */

/*
 * LPPS (sekigon low-power pointing stick) on the board's i2c1 pins:
 * SDA = P0.04 (D4), SCL = P0.05 (D5), already selected by i2c1_default.
 * Address, bus speed and the plain GPIO_PULL_UP on MOTION follow the driver
 * author's example; the driver tests the physical level itself, so do not
 * add GPIO_ACTIVE_LOW. FPC pin 1 is hard-wired 3V3: no power-gpios.
 */
&i2c1 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>;

    lpps: lpps@57 {
        status = "okay";
        compatible = "lpps";
        reg = <0x57>;
        irq-gpios = <&gpio1 11 GPIO_PULL_UP>;  /* MOTION  D6 */
    };
};

/*
 * Included here, after the matrix transform: these pull in keys.h, whose
 * RC() (right-control modifier) replaces the transform's RC(row,col).
 */
#include <behaviors.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/runtime_input_processor.h>

/*
 * Pointer tuning lives in the DYA Studio runtime processors so the Studio
 * pointing tab can change it; these are the flashed defaults. Values saved
 * from Studio override them until settings are reset.
 *
 * Mouse: the stick's raw Y is upside down on this board (checked on the real
 * unit), X is correct, raw speed is right at 1:1. Movement turns on the
 * Mouse layer (4) at once and it drops 1 s after the stick goes idle, as on
 * aerogu34.
 */
&mouse_runtime_input_processor {
    y-invert;
    temp-layer-enabled;
    temp-layer = <4>;
    temp-layer-activation-delay-ms = <0>;
    temp-layer-deactivation-delay-ms = <1000>;
};

/*
 * Scroll: only on the Scroll layer (3). It runs after the mouse processor,
 * so Y is inverted back: raw +Y is "up", the wheel's positive direction.
 * 1/10 was checked by feel on the real unit. Y-axis snap as on aerogu34;
 * its threshold is still the aerogu34 (PAW3222) value.
 */
&scroll_runtime_input_processor {
    processor-label = "scroll";
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    y-invert;
    scale-multiplier = <1>;
    scale-divisor = <10>;
    active-layers = <8>;  /* BIT(3) */
    axis-snap-mode = <AXIS_SNAP_MODE_Y>;
    axis-snap-threshold = <200>;
};

/ {
    /*
     * Deadzone in front of everything, so stick drift neither moves the
     * pointer nor turns on the Mouse layer. Seen on the real unit: an idle,
     * slightly drifting stick reports x/y of +-1 about every 100 ms, i.e.
     * 2 counts per report. Reports must add up to `threshold` counts with no
     * gap longer than `timeout-ms` before movement passes; the gap is kept
     * below the drift interval so drift never accumulates. First guess, not
     * yet tuned by feel. Not adjustable from Studio.
     */
    lpps_deadzone: lpps_deadzone {
        compatible = "zmk,input-processor-deadzone";
        #input-processor-cells = <0>;
        threshold = <6>;
        timeout-ms = <80>;
    };

    lpps_listener: lpps_listener {
        compatible = "zmk,input-listener";
        device = <&lpps>;
        input-processors = <&lpps_deadzone
                            &mouse_runtime_input_processor
                            &scroll_runtime_input_processor>;
    };
};

/*
 * The board adds a USB CDC ACM port for the console. DYA Studio needs the
 * Studio RPC port (studio-rpc-usb-uart snippet) to be the only one.
 */
&board_cdc_acm_uart { status = "disabled"; };

/*
 * Battery, AAAA module profile (NiMH cell).
 * The module feeds the cell voltage (after the reverse-protection FET) to
 * P0.02/AIN0 through 1 MOhm / 470 kOhm. The board's own divider on AIN7 sees
 * the 3.3 V boost output and says nothing about the cell, so the board's
 * vbatt node is repointed rather than adding a second one. No enable GPIO
 * exists for this divider, and P0.02 must stay free of pulls.
 *
 * Thresholds are the cell mV at 0,10,...,100 %: a provisional NiMH discharge
 * shape ending at the module's ~1.0 V hardware cut-off. Not yet checked
 * against a meter. A LiPo module leaves P0.02 floating and needs the board
 * default instead of this block.
 */
&vbatt {
    io-channels = <&adc 0>;
    /delete-property/ power-gpios;
    output-ohms = <470000>;
    full-ohms = <(1000000 + 470000)>;
    mv-to-pct-thresholds = <1000 1120 1170 1195 1210 1225 1240 1255 1275 1305 1380>;
};
